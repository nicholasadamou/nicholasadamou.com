{
  "name": "nicholasadamou.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "download:images:unsplash": "node scripts/build/download-unsplash.js",
    "capture:previews": "node scripts/build/capture-previews.mjs",
    "prepare-chatbot-data": "node scripts/content/prepare-chatbot.js",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint:markdown": "markdownlint-cli2",
    "lint:mermaid": "node scripts/check/mermaid.mjs",
    "lint:budget": "node scripts/check/budget.mjs",
    "check": "bun run check:static && bun run test:run",
    "ci": "bun run check:static && bun run test:coverage && bun run build",
    "check:static": "bun run lint && bun run typecheck && bun run format:check && bun run lint:markdown && bun run lint:mermaid && bun run lint:budget && bun run lint:shell && bun run audit && bun run docs:check",
    "capture:clients": "bun scripts/build/capture-clients.ts",
    "audit": "node scripts/check/audit.mjs",
    "lint:shell": "git ls-files -z \"*.sh\" | xargs -0 shellcheck -e SC1091 -S error",
    "docs:check": "python -m venv .flox/cache/docs-venv && .flox/cache/docs-venv/bin/pip install -q -r docs/requirements.txt && .flox/cache/docs-venv/bin/mkdocs build --strict -f docs/mkdocs.yml"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/postgres": "^0.10.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "react": "19.2.4",
    "react-colorful": "^5.8.1",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.90.0",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "uuid": "^13.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@akebifiky/remark-simple-plantuml": "^1.0.2",
    "@mapbox/rehype-prism": "^0.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/mapbox__rehype-prism": "^0.8.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.3",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mdx}": [
      "prettier --write"
    ]
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
